# Local test DB. To go live, swap in your Atlas cluster string — nothing else changes:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=manendi
PORT=4100
HOST=127.0.0.1

# USCIS Case Status API (developer.uscis.gov). Sandbox keys work against api-int; production keys come after the
# USCIS demo. USCIS_MOCK=1 serves made-up statuses so the app can be exercised without any keys.
# USCIS_BASE=https://api-int.uscis.gov
# USCIS_CLIENT_ID=
# USCIS_CLIENT_SECRET=
USCIS_MOCK=1

# Manendi Plus (RevenueCat). Without a key, purchases run in test mode (no charge) outside production.
# REVENUECAT_SECRET_KEY=sk_...
# BILLING_DEV=false
# Play reviewers can't buy: this code (Play Console › Sign in details) unlocks Plus for 30 days on Android.
# REVIEW_CODE=

# Store pages (/privacy, /terms, /support, /erase). Required when NODE_ENV=production.
# SUPPORT_EMAIL=support@yourdomain.com
# LEGAL_NAME=Bonhomie LLC
# LEGAL_ADDRESS=Street, City, State ZIP, USA
